@page
@model Orbit.Areas.Identity.Pages.Account.Manage.PersonalDataModel
@{
    ViewData["Title"] = "Personal data";
}

<div class="card mx-auto mt-4" style="max-width:36rem">
    <div class="card-body">
        <h1 class="h4">Personal data</h1>
        <p class="text-muted">Orbit keeps your tasks, comments and time entries attributed to you so the team's history stays intact. Account deactivation is handled by a System Admin rather than by deleting the account.</p>
        <a class="btn btn-outline-secondary" asp-area="Identity" asp-page="/Account/Manage/Index">Back to account</a>
    </div>
</div>

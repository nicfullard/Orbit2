{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=orbit;Username=orbit;Password=CHANGE_ME"
  },
  "App": {
    "BaseUrl": "https://localhost:7179"
  },
  "Database": {
    "ApplyMigrations": true
  },
  "DataProtection": {
    "KeyRingPath": ""
  },
  "Jobs": {
    "RecurringTasks": {
      "Enabled": true,
      "Cron": "0 0 2 * * ?",
      "RunOnStartup": true
    },
    "DueDateNotifications": {
      "Enabled": true,
      "LeadDays": 1,
      "Cron": "0 0 7 * * ?",
      "RunOnStartup": true
    }
  },
  "Security": {
    "Lockout": {
      "MaxFailedAttempts": 3,
      "LockoutMinutes": 30
    },
    "LoginThrottle": {
      "Enabled": true,
      "MaxFailures": 20,
      "WindowMinutes": 15
    }
  },
  "Agents": {
    "CommandTimeoutSeconds": 15,
    "RegistrationTokenLifetimeMinutes": 60
  },
  "CriticalPath": {
    "NearCriticalThresholdWorkingDays": 5,
    "BufferAmberPercent": 33,
    "BufferRedPercent": 66,
    "HoursPerWorkingDay": 8
  },
  "Attachments": {
    "MaxFileSizeMb": 25,
    "MaxFilesPerUpload": 5
  },
  "Seed": {
    "Admin": {
      "Email": "",
      "DisplayName": "",
      "Password": ""
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}

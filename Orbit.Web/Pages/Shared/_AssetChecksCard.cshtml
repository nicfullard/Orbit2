@model AssetCheckSummary
@* The dashboard's Asset checks card (spec §6.9, §6.19): what is overdue, due soon or not OK within the viewer's assets.check reach. *@
<div class="card mb-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span class="fw-semibold">Asset checks</span>
        <a class="small text-decoration-none" asp-page="/Assets/Index" asp-route-Check="Due">Open</a>
    </div>
    <div class="card-body py-2 small">
        @if (Model.Scope == PermissionScope.Own)
        {
            <div class="mb-1">
                You hold <a class="fw-semibold text-decoration-none" asp-page="/Assets/Index" asp-route-Holder="me">@Model.Held @(Model.Held == 1 ? "asset" : "assets")</a>.
            </div>
        }
        @if (Model.Overdue == 0 && Model.DueSoon == 0 && Model.NotOk == 0)
        {
            <span class="text-muted">No checks due@(Model.Scope == PermissionScope.Own ? " on your assets" : "").</span>
        }
        else
        {
            <div class="d-flex flex-wrap gap-3">
                <a class="text-decoration-none" asp-page="/Assets/Index" asp-route-Check="Overdue"><span class="fs-5 fw-semibold text-danger">@Model.Overdue</span> overdue</a>
                <a class="text-decoration-none" asp-page="/Assets/Index" asp-route-Check="DueSoon"><span class="fs-5 fw-semibold text-warning-emphasis">@Model.DueSoon</span> due soon</a>
                <a class="text-decoration-none" asp-page="/Assets/Index" asp-route-Check="NotOk"><span class="fs-5 fw-semibold">@Model.NotOk</span> last check not OK</a>
            </div>
        }
    </div>
</div>

@model WaitingApprovalsVm
@* The dashboard's My waiting approvals card (spec §6.9, §6.20): the request approvals asked of the viewer and still open, oldest
   first, each linking to its request. Shown to a role that can open requests, with a line saying so when nothing waits. *@
@{
    var more = Model.Items.Count - WaitingApprovalsVm.Shown;
}
<div class="card mb-3 @(Model.Items.Count > 0 ? "border-primary" : "")">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span class="fw-semibold">
            My waiting approvals
            @if (Model.Items.Count > 0) { <span class="badge text-bg-primary ms-1">@Model.Items.Count</span> }
        </span>
        <a class="small text-decoration-none" asp-page="/Requests/Index">Requests</a>
    </div>
    <ul class="list-group list-group-flush">
        @if (Model.Items.Count == 0)
        {
            <li class="list-group-item text-muted fst-italic">Nothing is waiting for your approval.</li>
        }
        @foreach (var w in Model.Items.Take(WaitingApprovalsVm.Shown))
        {
            <li class="list-group-item d-flex justify-content-between align-items-center gap-2">
                <div class="text-truncate">
                    <a asp-page="/Requests/Request" asp-route-id="@w.Request.Id" class="text-decoration-none">@w.Request.Title</a>
                    <div class="small text-muted text-truncate">
                        <span class="font-monospace">@w.Request.Number</span> · @w.Step.FlowStep.Title · logged by @(w.Request.RequesterId == Model.MeId ? "you" : w.Request.Requester.DisplayName)
                    </div>
                </div>
                <span class="badge text-bg-light border text-nowrap" title="Waiting since @Ui.When(w.Since)">@Ui.Ago(w.Since)</span>
            </li>
        }
        @if (more > 0)
        {
            <li class="list-group-item small">
                <a class="text-decoration-none" asp-page="/Requests/Index">@more more on the Requests page</a>
            </li>
        }
    </ul>
</div>

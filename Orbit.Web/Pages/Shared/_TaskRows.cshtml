@model TaskRowsVm

@if (Model.Tasks.Count == 0)
{
    <p class="text-muted fst-italic mb-0 p-2">@(Model.EmptyMessage ?? "No tasks.")</p>
}
else
{
    var selectable = !string.IsNullOrEmpty(Model.SelectionFormId);
    <div class="table-responsive">
        <table class="table table-sm table-hover table-tasks align-middle mb-0">
            <thead class="table-light">
                <tr>
                    @if (selectable)
                    {
                        <th style="width:2rem"><input type="checkbox" class="form-check-input js-select-all" title="Select all" /></th>
                    }
                    @if (Model.ShowPlanToday)
                    {
                        <th class="text-center" style="width:3.5rem" title="On today's day plan">Today</th>
                    }
                    <th>Task</th>
                    @if (Model.ShowProject) { <th>Project</th> }
                    @if (Model.ShowDepartment) { <th>Department</th> }
                    <th>Priority</th>
                    @if (Model.ShowAssignee) { <th>Assignee</th> }
                    <th>Due</th>
                    @if (Model.ShowSprint) { <th>Sprint</th> }
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Model.Tasks)
                {
                    var canView = AccessPolicy.CanViewTask(Model.Actor, t);
                    var overdue = t.IsOverdue(Model.Today);
                    var statuses = Ui.AllowedStatuses(Model.Actor, t);
                    var canEdit = canView && AccessPolicy.CanEditTask(Model.Actor, t);
                    var quickEdit = Model.QuickEditAssignees is not null && canEdit;
                    var quickDue = quickEdit || (Model.QuickEditDueDate && canEdit);
                    <tr>
                        @if (selectable)
                        {
                            <td>
                                @if (AccessPolicy.CanPlanTask(Model.Actor, t))
                                {
                                    <input type="checkbox" class="form-check-input js-select-item" name="selected" value="@t.Id" form="@Model.SelectionFormId" />
                                }
                            </td>
                        }
                        @if (Model.ShowPlanToday)
                        {
                            var plannedToday = t.PlannedFor == Model.Today;
                            <td class="text-center">
                                @if (t.IsOpen && AccessPolicy.CanPlanTask(Model.Actor, t))
                                {
                                    <form method="post" asp-page="/Tasks/Quick" asp-page-handler="PlanToday" asp-route-id="@t.Id" asp-route-returnUrl="@Model.ReturnUrl" class="d-inline">
                                        <input type="checkbox" name="planned" value="true" class="form-check-input js-autosubmit" checked="@plannedToday" aria-label="Planned for today"
                                               title="@(plannedToday ? "On today's plan - untick to remove" : t.PlannedFor is DateOnly other ? $"Planned for {Ui.Day(other)} - tick to move to today" : "Tick to plan for today")" />
                                    </form>
                                }
                                else if (plannedToday)
                                {
                                    <span class="badge text-bg-light border" title="Was on today's plan">Today</span>
                                }
                            </td>
                        }
                        <td>
                            @if (canView)
                            {
                                <a asp-page="/Tasks/Details" asp-route-id="@t.Id" class="fw-semibold text-decoration-none @(overdue ? "task-title-overdue" : "")">@t.Title</a>
                            }
                            else
                            {
                                <span class="fw-semibold">@t.Title</span>
                            }
                            @if (t.Type != TaskType.Task)
                            {
                                <span class="badge @Ui.TypeBadge(t.Type) ms-1" title="Type">@t.Type</span>
                            }
                            @if (t.Source != TaskSource.Manual)
                            {
                                <span class="badge @Ui.SourceBadge(t.Source) ms-1">@Ui.SourceLabel(t.Source)</span>
                            }
                            @if (Model.Waiting is not null && Model.Waiting.TryGetValue(t.Id, out var waiting))
                            {
                                <span class="badge text-bg-warning ms-1" title="@waiting.Reason">Gated</span>
                            }
                            @if (t.ParentTask is not null)
                            {
                                <div class="small text-muted" title="Subtask of @t.ParentTask.Title">in: @Ui.Truncate(t.ParentTask.Title, 60)</div>
                            }
                        </td>
                        @if (Model.ShowProject)
                        {
                            <td>
                                @if (t.Project is not null)
                                {
                                    <a asp-page="/Projects/Details" asp-route-id="@t.ProjectId" class="text-decoration-none">@t.Project.Name</a>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                        }
                        @if (Model.ShowDepartment)
                        {
                            <td><span class="badge text-bg-light border">@t.Department?.Name</span></td>
                        }
                        <td><span class="badge @Ui.PriorityBadge(t.Priority)">@t.Priority</span></td>
                        @if (Model.ShowAssignee)
                        {
                            <td>
                                @if (quickEdit)
                                {
                                    <form method="post" asp-page="/Tasks/Quick" asp-page-handler="Assignee" asp-route-id="@t.Id" asp-route-returnUrl="@Model.ReturnUrl" class="d-inline">
                                        <select name="assigneeId" class="form-select form-select-sm assignee-select js-autosubmit" aria-label="Assignee">
                                            <option value="" selected="@(t.AssigneeId is null)">Unassigned</option>
                                            @foreach (var u in Model.QuickEditAssignees!.Where(u => u.DepartmentId == t.DepartmentId || u.Role == OrbitRole.SystemAdmin))
                                            {
                                                <option value="@u.Id" selected="@(u.Id == t.AssigneeId)">@u.DisplayName</option>
                                            }
                                        </select>
                                    </form>
                                }
                                else if (AccessPolicy.CanTakeTask(Model.Actor, t))
                                {
                                    <form method="post" asp-page="/Tasks/Quick" asp-page-handler="Take" asp-route-id="@t.Id" asp-route-returnUrl="@Model.ReturnUrl" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-outline-primary py-0" title="Unassigned - assign this task to yourself">Take</button>
                                    </form>
                                }
                                else
                                {
                                    @(t.Assignee?.DisplayName ?? "-")
                                }
                            </td>
                        }
                        <td class="@(overdue ? "text-danger fw-semibold" : "")">
                            @if (quickDue)
                            {
                                var due = t.DueDate?.ToString("yyyy-MM-dd") ?? string.Empty;
                                <form method="post" asp-page="/Tasks/Quick" asp-page-handler="DueDate" asp-route-id="@t.Id" asp-route-returnUrl="@Model.ReturnUrl" class="d-inline">
                                    <input type="date" name="dueDate" value="@due" data-original="@due" class="form-control form-control-sm due-input js-autosubmit-delayed @(overdue ? "border-danger text-danger" : "")" aria-label="Due date" title="@(overdue ? "Overdue" : "Due date")" />
                                </form>
                            }
                            else
                            {
                                @Ui.Day(t.DueDate)@(overdue ? " (overdue)" : "")
                            }
                        </td>
                        @if (Model.ShowSprint)
                        {
                            <td>
                                @if (t.Sprint is not null)
                                {
                                    <a asp-page="/Sprints/Details" asp-route-id="@t.SprintId" class="text-decoration-none">@t.Sprint.Name</a>
                                }
                                else
                                {
                                    <span class="text-muted">Backlog</span>
                                }
                            </td>
                        }
                        <td>
                            @if (canView && statuses.Count > 1)
                            {
                                <form method="post" asp-page="/Tasks/Status" asp-route-id="@t.Id" asp-route-returnUrl="@Model.ReturnUrl" class="d-inline">
                                    <select name="status" class="form-select form-select-sm status-select js-autosubmit" aria-label="Status">
                                        @foreach (var s in statuses)
                                        {
                                            <option value="@s" selected="@(s == t.Status)">@s.Label()</option>
                                        }
                                    </select>
                                </form>
                            }
                            else
                            {
                                <span class="badge @Ui.StatusBadge(t.Status)">@t.Status.Label()</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

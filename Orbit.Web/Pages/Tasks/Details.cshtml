@page "{id:guid}"
@model Orbit.Pages.Tasks.DetailsModel
@{
    var t = Model.Task;
    ViewData["Title"] = t.Title;
    var today = DateOnly.FromDateTime(DateTime.UtcNow);
    var overdue = t.IsOverdue(today);
    var returnUrl = Request.Path.ToString();
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a asp-page="/Tasks/Index">Tasks</a></li>
        @if (t.Project is not null)
        {
            <li class="breadcrumb-item"><a asp-page="/Projects/Details" asp-route-id="@t.ProjectId">@t.Project.Name</a></li>
        }
        @foreach (var a in Model.Structure.Ancestors)
        {
            <li class="breadcrumb-item">
                @if (AccessPolicy.CanViewTask(Model.Actor, a))
                {
                    <a asp-page="/Tasks/Details" asp-route-id="@a.Id" title="Parent task">@Ui.Truncate(a.Title, 40)</a>
                }
                else
                {
                    <span title="Parent task (@a.Department.Name)">@Ui.Truncate(a.Title, 40)</span>
                }
            </li>
        }
        <li class="breadcrumb-item active" aria-current="page">@Ui.Truncate(t.Title, 60)</li>
    </ol>
</nav>

<div class="d-flex flex-wrap justify-content-between align-items-start mb-3 gap-2">
    <div>
        <h1 class="h3 mb-1 @(overdue ? "task-title-overdue" : "")">@t.Title</h1>
        <div class="d-flex flex-wrap gap-1 align-items-center">
            <span class="badge @Ui.StatusBadge(t.Status)">@t.Status.Label()</span>
            <span class="badge @Ui.PriorityBadge(t.Priority)">@t.Priority</span>
            <span class="badge @Ui.TypeBadge(t.Type)" title="Type">@t.Type</span>
            <span class="badge @Ui.SourceBadge(t.Source)">@Ui.SourceLabel(t.Source)</span>
            <span class="badge text-bg-light border">@t.Department.Name</span>
            @if (t.Sprint is not null)
            {
                <a asp-page="/Sprints/Details" asp-route-id="@t.SprintId" class="badge text-bg-light border text-decoration-none">Sprint: @t.Sprint.Name</a>
            }
            else
            {
                <span class="badge text-bg-light border">Backlog</span>
            }
            @if (overdue)
            {
                <span class="badge text-bg-danger">Overdue</span>
            }
            @if (Model.Structure.WaitingOn.Count > 0)
            {
                <span class="badge text-bg-warning" title="@(t.Status == TaskItemStatus.Todo ? "Can't start until: " : "Can't finish until: ")@string.Join("; ", Model.Structure.WaitingOn.Select(w => w.Describe()))">Waiting</span>
            }
            @if (Model.Structure.HasDateConflict)
            {
                <span class="badge bg-warning-subtle text-warning-emphasis border" title="A dependency's planned dates don't add up - see Dependencies">Date conflict</span>
            }
            @if (t.PlannedFor == today)
            {
                <span class="badge text-bg-primary" title="On today's day plan">Today</span>
            }
            else if (t.PlannedFor is DateOnly plannedFor)
            {
                <span class="badge text-bg-light border" title="On the day plan for @Ui.Day(plannedFor)">Planned @Ui.Day(plannedFor)</span>
            }
        </div>
    </div>
    <div class="d-flex gap-2 align-items-center">
        @if (t.IsOpen && AccessPolicy.CanPlanTask(Model.Actor, t))
        {
            var onTodaysPlan = t.PlannedFor == today;
            <form method="post" asp-page="/Tasks/Quick" asp-page-handler="PlanToday" asp-route-id="@t.Id" asp-route-returnUrl="@returnUrl">
                @if (!onTodaysPlan)
                {
                    <input type="hidden" name="planned" value="true" />
                }
                <button class="btn btn-sm @(onTodaysPlan ? "btn-outline-secondary" : "btn-outline-primary")" type="submit"
                        title="@(onTodaysPlan ? "Take this task off today's day plan" : "Put this task on today's day plan")">@(onTodaysPlan ? "Remove from today" : "Plan for today")</button>
            </form>
        }
        @if (Model.Clock is not null)
        {
            var startedAt = DateTime.SpecifyKind(Model.Clock.StartedAt, DateTimeKind.Utc);
            <form method="post" asp-page-handler="StopClock" asp-route-id="@t.Id" class="d-flex align-items-center gap-2 js-clock"
                  data-clock-started="@startedAt.ToString("o")">
                <span class="badge text-bg-success font-monospace fs-6 js-clock-elapsed" title="Clock running since @Ui.When(startedAt)">@((DateTime.UtcNow - startedAt).ToString(@"hh\:mm\:ss"))</span>
                <button class="btn btn-danger btn-sm" type="submit">Stop Clock</button>
            </form>
            @* Submitted with navigator.sendBeacon when the user leaves the page while the clock is running. *@
            <form method="post" asp-page-handler="StopClockBeacon" asp-route-id="@t.Id" class="d-none js-clock-beacon"></form>
        }
        else if (Model.CanStartClock)
        {
            <form method="post" asp-page-handler="StartClock" asp-route-id="@t.Id">
                <button class="btn btn-success btn-sm" type="submit" title="Time yourself on this task; the time is logged when you stop the clock or leave the page">Start Clock</button>
            </form>
        }
        @if (Model.Statuses.Count > 1)
        {
            <form method="post" asp-page="/Tasks/Status" asp-route-id="@t.Id" asp-route-returnUrl="@returnUrl" class="d-flex align-items-center gap-1">
                <label class="small text-muted" for="quickStatus">Status</label>
                <select id="quickStatus" name="status" class="form-select form-select-sm status-select js-autosubmit">
                    @foreach (var s in Model.Statuses)
                    {
                        <option value="@s" selected="@(s == t.Status)">@s.Label()</option>
                    }
                </select>
            </form>
        }
        @if (Model.CanEdit)
        {
            <a class="btn btn-outline-primary btn-sm" asp-page="/Tasks/Edit" asp-route-id="@t.Id">Edit</a>
        }
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="card mb-3">
            <div class="card-body">
                @if (string.IsNullOrWhiteSpace(t.Description))
                {
                    <p class="text-muted fst-italic mb-0">No description.</p>
                }
                else
                {
                    <div class="description-box">@t.Description</div>
                }
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="fw-semibold">Subtasks <span class="text-muted fw-normal">(@Model.Structure.ChildrenClosed/@Model.Structure.Children.Count done)</span></span>
                @if (Model.CanAddSubtask)
                {
                    <a class="btn btn-sm btn-outline-primary" asp-page="/Tasks/Create" asp-route-parentTaskId="@t.Id">Add subtask</a>
                }
            </div>
            @if (Model.Structure.Children.Count > 0)
            {
                <div class="table-responsive">
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead class="table-light"><tr><th>Task</th><th>Department</th><th>Assignee</th><th>Start</th><th>Due</th><th>Status</th></tr></thead>
                        <tbody>
                            @foreach (var c in Model.Structure.Children)
                            {
                                <tr>
                                    <td>
                                        @if (AccessPolicy.CanViewTask(Model.Actor, c))
                                        {
                                            <a asp-page="/Tasks/Details" asp-route-id="@c.Id" class="text-decoration-none fw-semibold">@c.Title</a>
                                        }
                                        else
                                        {
                                            <span class="fw-semibold">@c.Title</span>
                                        }
                                    </td>
                                    <td><span class="badge text-bg-light border">@c.Department.Name</span></td>
                                    <td>@(c.Assignee?.DisplayName ?? "-")</td>
                                    <td>@Ui.Day(c.StartDate)</td>
                                    <td class="@(c.IsOverdue(today) ? "text-danger fw-semibold" : "")">@Ui.Day(c.DueDate)</td>
                                    <td><span class="badge @Ui.StatusBadge(c.Status)">@c.Status.Label()</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="card-body py-2"><p class="text-muted small mb-0">No subtasks.@(Model.CanAddSubtask ? " Break this task down with \"Add subtask\"." : "")</p></div>
            }
        </div>

        <div class="card mb-3">
            <div class="card-header fw-semibold">Dependencies</div>
            <div class="card-body">
                <h2 class="h6">Waiting on <span class="text-muted fw-normal">(@Model.Structure.Predecessors.Count)</span></h2>
                @if (Model.Structure.Predecessors.Count == 0)
                {
                    <p class="text-muted small">This task doesn't wait on any other task.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-3">
                            <thead class="table-light"><tr><th>Task</th><th>Type</th><th>Lag</th><th>Its status</th><th>Gate</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var d in Model.Structure.Predecessors)
                                {
                                    <tr>
                                        <td>
                                            @if (AccessPolicy.CanViewTask(Model.Actor, d.Other))
                                            {
                                                <a asp-page="/Tasks/Details" asp-route-id="@d.Other.Id" class="text-decoration-none">@d.Other.Title</a>
                                            }
                                            else
                                            {
                                                <span>@d.Other.Title</span>
                                            }
                                            <span class="badge text-bg-light border ms-1">@d.Other.Department.Name</span>
                                            @if (d.DateConflict)
                                            {
                                                <span class="badge bg-warning-subtle text-warning-emphasis border ms-1" title="This task's planned dates are earlier than this link allows">Date conflict</span>
                                            }
                                        </td>
                                        <td><abbr title="@d.Link.Type.Label()">@d.Link.Type.Code()</abbr></td>
                                        <td>@Ui.Lag(d.Link.LagDays)</td>
                                        <td><span class="badge @Ui.StatusBadge(d.Other.Status)">@d.Other.Status.Label()</span></td>
                                        <td>
                                            @if (d.Met)
                                            {
                                                <span class="text-success">met</span>
                                            }
                                            else
                                            {
                                                <span class="text-warning-emphasis">waiting for it to @(d.Link.Type.WaitsForFinish() ? "finish" : "start")</span>
                                            }
                                        </td>
                                        <td class="text-end text-nowrap">
                                            @if (d.CanRemove)
                                            {
                                                <form method="post" asp-page-handler="RemoveDependency" asp-route-id="@t.Id" asp-route-linkId="@d.Link.Id" class="d-inline" data-confirm="Remove this dependency?">
                                                    <button class="btn btn-link btn-sm py-0 text-danger" type="submit">Remove</button>
                                                </form>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                <h2 class="h6">Blocks <span class="text-muted fw-normal">(@Model.Structure.Successors.Count)</span></h2>
                @if (Model.Structure.Successors.Count == 0)
                {
                    <p class="text-muted small">No task waits on this one.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-3">
                            <thead class="table-light"><tr><th>Task</th><th>Type</th><th>Lag</th><th>Its status</th><th>Gate</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var d in Model.Structure.Successors)
                                {
                                    <tr>
                                        <td>
                                            @if (AccessPolicy.CanViewTask(Model.Actor, d.Other))
                                            {
                                                <a asp-page="/Tasks/Details" asp-route-id="@d.Other.Id" class="text-decoration-none">@d.Other.Title</a>
                                            }
                                            else
                                            {
                                                <span>@d.Other.Title</span>
                                            }
                                            <span class="badge text-bg-light border ms-1">@d.Other.Department.Name</span>
                                            @if (d.DateConflict)
                                            {
                                                <span class="badge bg-warning-subtle text-warning-emphasis border ms-1" title="That task's planned dates are earlier than this link allows">Date conflict</span>
                                            }
                                        </td>
                                        <td><abbr title="@d.Link.Type.Label()">@d.Link.Type.Code()</abbr></td>
                                        <td>@Ui.Lag(d.Link.LagDays)</td>
                                        <td><span class="badge @Ui.StatusBadge(d.Other.Status)">@d.Other.Status.Label()</span></td>
                                        <td>
                                            @if (d.Met)
                                            {
                                                <span class="text-success">released</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">held until this task @(d.Link.Type.WaitsForFinish() ? "finishes" : "starts")</span>
                                            }
                                        </td>
                                        <td class="text-end text-nowrap">
                                            @if (d.CanRemove)
                                            {
                                                <form method="post" asp-page-handler="RemoveDependency" asp-route-id="@t.Id" asp-route-linkId="@d.Link.Id" class="d-inline" data-confirm="Remove this dependency?">
                                                    <button class="btn btn-link btn-sm py-0 text-danger" type="submit">Remove</button>
                                                </form>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                @if (Model.CanLink)
                {
                    <form method="post" asp-page-handler="AddDependency" asp-route-id="@t.Id" class="row g-2 align-items-end mt-1">
                        <div class="col-sm-3">
                            <label class="form-label small mb-0" for="depDirection">This task</label>
                            <select class="form-select form-select-sm" id="depDirection" name="direction">
                                <option value="waits-on">waits on</option>
                                <option value="blocks">is waited on by</option>
                            </select>
                        </div>
                        <div class="col-sm-4">
                            <label class="form-label small mb-0" for="depOther">Task</label>
                            <select class="form-select form-select-sm" id="depOther" name="otherTaskId" required>
                                <option value="">Choose a task on the same @(t.Project is null ? "department (standalone)" : "project")</option>
                                @foreach (var c in Model.LinkCandidates)
                                {
                                    <option value="@c.Id">@c.Title (@c.Department.Name, @c.Status.Label())</option>
                                }
                            </select>
                        </div>
                        <div class="col-sm-3">
                            <label class="form-label small mb-0" for="depType">Type</label>
                            <select class="form-select form-select-sm" id="depType" name="type" asp-items="Ui.DependencyTypeItems(DependencyType.FinishToStart)"></select>
                        </div>
                        <div class="col-sm-1">
                            <label class="form-label small mb-0" for="depLag">Lag (d)</label>
                            <input type="number" class="form-control form-control-sm" id="depLag" name="lagDays" value="0" min="-3650" max="3650" />
                        </div>
                        <div class="col-auto">
                            <button class="btn btn-sm btn-outline-primary" type="submit">Add</button>
                        </div>
                    </form>
                    <div class="form-text">FS: can't start until it finishes. SS: can't start until it starts. FF: can't finish until it finishes. SF: can't finish until it starts. Lag only affects the planned-date check, never the workflow gate.</div>
                }
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header fw-semibold">Comments <span class="text-muted fw-normal">(@Model.Comments.Count)</span></div>
            <div class="card-body">
                @foreach (var c in Model.Comments)
                {
                    var isClaude = c.Author is null || c.Author.IsSystemAccount;
                    <div class="border-bottom pb-2 mb-2">
                        <div class="small">
                            <span class="fw-semibold">@Ui.AuthorName(c.Author)</span>
                            @if (isClaude)
                            {
                                <span class="badge badge-claude">Claude</span>
                            }
                            <span class="text-muted">· @Ui.When(c.CreatedAt)</span>
                        </div>
                        <div class="description-box">@c.Body</div>
                    </div>
                }
                <form method="post" asp-page-handler="Comment" asp-route-id="@t.Id">
                    <textarea class="form-control mb-2" name="CommentBody" rows="3" placeholder="Add a comment" required></textarea>
                    <button class="btn btn-sm btn-primary" type="submit">Post comment</button>
                </form>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between">
                <span class="fw-semibold">Time logged</span>
                <span class="text-muted">@TimeFormat.Minutes(Model.TotalMinutes) total</span>
            </div>
            <div class="card-body">
                @if (Model.TimeEntries.Count > 0)
                {
                    <table class="table table-sm mb-3">
                        <thead class="table-light"><tr><th>Date</th><th>Who</th><th>Duration</th><th>Note</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var e in Model.TimeEntries)
                            {
                                var canEditEntry = AccessPolicy.CanEditTimeEntry(Model.Actor, e, t);
                                <tr>
                                    <td>@Ui.Day(e.Date)</td>
                                    <td>@e.User.DisplayName</td>
                                    <td>@TimeFormat.Minutes(e.DurationMinutes)</td>
                                    <td>@e.Note</td>
                                    <td class="text-end text-nowrap">
                                        @if (canEditEntry)
                                        {
                                            <a class="btn btn-link btn-sm py-0" asp-page="/Time/Edit" asp-route-id="@e.Id">Edit</a>
                                            <form method="post" asp-page-handler="DeleteTime" asp-route-id="@t.Id" asp-route-entryId="@e.Id" class="d-inline" data-confirm="Delete this time entry?">
                                                <button class="btn btn-link btn-sm py-0 text-danger" type="submit">Delete</button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                @if (Model.CanLogTime)
                {
                    <form method="post" asp-page-handler="Time" asp-route-id="@t.Id" class="row g-2 align-items-end">
                        <div class="col-sm-3">
                            <label class="form-label small mb-0">Date</label>
                            <input type="date" class="form-control form-control-sm" name="Time.Date" value="@today.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="col-sm-2">
                            <label class="form-label small mb-0">Minutes</label>
                            <input type="number" class="form-control form-control-sm" name="Time.DurationMinutes" value="60" min="1" max="1440" required />
                        </div>
                        @if (Model.CanLogForOthers)
                        {
                            <div class="col-sm-3">
                                <label class="form-label small mb-0">For</label>
                                <select class="form-select form-select-sm" name="Time.UserId">
                                    <option value="">Me</option>
                                    @foreach (var u in Model.TimeUsers)
                                    {
                                        <option value="@u.Id">@u.DisplayName</option>
                                    }
                                </select>
                            </div>
                        }
                        <div class="col-sm">
                            <label class="form-label small mb-0">Note</label>
                            <input class="form-control form-control-sm" name="Time.Note" maxlength="1000" placeholder="optional" />
                        </div>
                        <div class="col-auto">
                            <button class="btn btn-sm btn-outline-primary" type="submit">Log time</button>
                        </div>
                    </form>
                }
                else
                {
                    <p class="text-muted small mb-0">You can log time on tasks assigned to you.</p>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card mb-3">
            <div class="card-header fw-semibold">Details</div>
            <div class="card-body small">
                <dl class="row mb-0">
                    <dt class="col-5">Project</dt>
                    <dd class="col-7">
                        @if (t.Project is not null)
                        {
                            <a asp-page="/Projects/Details" asp-route-id="@t.ProjectId">@t.Project.Name</a>
                            @if (t.Project.DepartmentId != t.DepartmentId)
                            {
                                <div class="text-muted">Owned by @t.Project.Department.Name; this task is @t.Department.Name's part of it.</div>
                            }
                        }
                        else
                        {
                            <span class="text-muted">Standalone</span>
                        }
                    </dd>
                    <dt class="col-5">Parent task</dt>
                    <dd class="col-7">
                        @if (t.ParentTask is not null)
                        {
                            @if (AccessPolicy.CanViewTask(Model.Actor, t.ParentTask))
                            {
                                <a asp-page="/Tasks/Details" asp-route-id="@t.ParentTaskId">@t.ParentTask.Title</a>
                            }
                            else
                            {
                                <span>@t.ParentTask.Title</span>
                            }
                        }
                        else
                        {
                            <span class="text-muted">None (top-level)</span>
                        }
                    </dd>
                    <dt class="col-5">Department</dt><dd class="col-7">@t.Department.Name</dd>
                    <dt class="col-5">Assignee</dt><dd class="col-7">@(t.Assignee?.DisplayName ?? "Unassigned")</dd>
                    <dt class="col-5">Start</dt><dd class="col-7">@Ui.Day(t.StartDate)</dd>
                    <dt class="col-5">Due</dt><dd class="col-7 @(overdue ? "text-danger fw-semibold" : "")">@Ui.Day(t.DueDate)</dd>
                    <dt class="col-5">Planned for</dt><dd class="col-7">@Ui.Day(t.PlannedFor)@(t.PlannedFor == today ? " (today)" : "")</dd>
                    <dt class="col-5">Created by</dt><dd class="col-7">@Ui.AuthorName(t.CreatedBy) <span class="text-muted">@Ui.When(t.CreatedAt)</span></dd>
                    <dt class="col-5">Updated</dt><dd class="col-7">@Ui.When(t.UpdatedAt)</dd>
                    <dt class="col-5">First responded</dt><dd class="col-7">@Ui.When(t.FirstRespondedAt)</dd>
                    <dt class="col-5">Completed</dt><dd class="col-7">@Ui.When(t.CompletedAt)</dd>
                    @if (t.RecurringTaskDefinition is not null)
                    {
                        <dt class="col-5">Recurring</dt>
                        <dd class="col-7"><a asp-page="/Recurring/Details" asp-route-id="@t.RecurringTaskDefinitionId">@t.RecurringTaskDefinition.Title</a></dd>
                    }
                    <dt class="col-5">Id</dt><dd class="col-7 text-muted key-box">@t.Id</dd>
                </dl>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header fw-semibold">History</div>
            <div class="card-body py-2">
                <ul class="list-unstyled activity-feed mb-0 small">
                    @if (Model.Activity.Count == 0)
                    {
                        <li class="text-muted fst-italic">No history.</li>
                    }
                    @foreach (var a in Model.Activity)
                    {
                        <li>
                            <span class="fw-semibold">@a.ActorName</span>
                            @if (a.ActorType == ActorType.Api) { <span class="badge badge-claude">Claude</span> }
                            @Ui.ActionLabel(a.Action) <span class="text-muted">· @Ui.When(a.Timestamp)</span>
                            @if (a.Details is { Length: > 2 })
                            {
                                <div class="text-muted key-box" style="font-size:.75rem">@Ui.Truncate(a.Details, 180)</div>
                            }
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>

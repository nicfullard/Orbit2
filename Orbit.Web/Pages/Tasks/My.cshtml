@page
@model Orbit.Pages.Tasks.MyModel
@{
    ViewData["Title"] = "My Tasks";
    var today = DateOnly.FromDateTime(DateTime.UtcNow);
    var overdue = Model.Tasks.Count(t => t.IsOverdue(today));
    var rows = new TaskRowsVm { Tasks = Model.Tasks, Actor = Model.Actor, ReturnUrl = Request.Path + Request.QueryString, ShowDepartment = false, ShowAssignee = false, ShowSprint = true, ShowPlanToday = true, QuickEditDueDate = true, Waiting = Model.Waiting, EmptyMessage = "Nothing assigned to you.", Today = today };
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <h1 class="h3 mb-0">My Tasks <span class="text-muted fs-6">@Model.Tasks.Count@(overdue > 0 ? $" · {overdue} overdue" : "")</span></h1>
    <div class="d-flex gap-2 align-items-center">
        <form method="get" class="d-flex align-items-center gap-2">
            <div class="form-check mb-0">
                <input class="form-check-input js-autosubmit" type="checkbox" name="IncludeClosed" value="true" id="includeClosed" checked="@Model.IncludeClosed" />
                <label class="form-check-label small" for="includeClosed">Include closed</label>
            </div>
        </form>
        <a class="btn btn-primary btn-sm" asp-page="/Tasks/Create">New task</a>
    </div>
</div>

<div class="card">
    <div class="card-body p-0 p-sm-2">
        <partial name="_TaskRows" model="rows" />
    </div>
</div>

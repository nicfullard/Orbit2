@page
@model Orbit.Pages.Requests.IndexModel
@{
    ViewData["Title"] = "Requests";
    // Department headings only help once more than one department offers requests.
    var byDepartment = Model.Sections.Count > 1;
}

<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
    <div>
        <h1 class="h3 mb-1">Log a request</h1>
        <div class="text-muted">Choose what you need. A few questions follow, and your request goes to the team that handles it.</div>
    </div>
    @if (Model.CanManage)
    {
        <a class="btn btn-outline-secondary btn-sm" asp-page="/Requests/Department">Department requests</a>
    }
</div>

@if (Model.Waiting.Count > 0)
{
    <div class="card mb-4 border-primary">
        <div class="card-header fw-semibold">Needs your action <span class="badge text-bg-primary ms-1">@Model.Waiting.Count</span></div>
        <ul class="list-group list-group-flush">
            @foreach (var w in Model.Waiting)
            {
                <li class="list-group-item d-flex flex-wrap align-items-center gap-2">
                    <div class="flex-grow-1">
                        <a asp-page="/Requests/Request" asp-route-id="@w.Request.Id" class="fw-semibold text-decoration-none">@w.What</a>
                        <div class="small text-muted">
                            <span class="font-monospace">@w.Request.Number</span> @w.Request.Title · logged by @(w.Request.RequesterId == Model.MeId ? "you" : w.Request.Requester.DisplayName)
                        </div>
                    </div>
                    <span class="small text-muted text-nowrap" title="@Ui.When(w.Since)">waiting @Ui.Ago(w.Since)</span>
                </li>
            }
        </ul>
    </div>
}

<partial name="_Steps" model="1" />

@if (Model.Sections.Count == 0)
{
    <div class="card mb-4">
        <div class="card-body text-center py-5">
            <div class="text-muted mb-2">@RequestIcons.Svg("chat", 32)</div>
            <p class="mb-1 fw-semibold">Nothing to request yet.</p>
            <p class="text-muted mb-0">
                No department has set up its request flows.
                @if (Model.CanConfigure) { <text>Set up your department's under Admin &gt; <a asp-page="/RequestCatalogue/Index">Request flows</a>.</text> }
            </p>
        </div>
    </div>
}

@foreach (var block in Model.Sections)
{
    @if (byDepartment)
    {
        <h2 class="h5 mt-2 mb-3">@block.Department.Name</h2>
    }
    <div class="row g-3 mb-4">
        @foreach (var c in block.Categories)
        {
            <div class="col-12 col-sm-6 col-xl-3">
                <a class="request-tile @RequestIcons.ColourClass(c.Colour)" asp-page="/Requests/Category" asp-route-id="@c.Id">
                    <span class="request-icon">@RequestIcons.Svg(c.Icon, 32)</span>
                    <span class="request-tile-title">@c.Title</span>
                    @if (!string.IsNullOrWhiteSpace(c.Description))
                    {
                        <span class="request-tile-text">@c.Description</span>
                    }
                    <span class="request-go">@RequestIcons.Svg("arrow-right", 18)</span>
                </a>
            </div>
        }
    </div>
}

<div class="card">
    <div class="card-header fw-semibold">Your requests</div>
    @if (Model.Mine.Count == 0)
    {
        <div class="card-body text-muted fst-italic">You haven't logged any requests yet.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Request</th>
                        <th class="d-none d-md-table-cell">With</th>
                        <th>Status</th>
                        <th class="d-none d-sm-table-cell">Logged</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Mine)
                    {
                        <tr>
                            <td>
                                <span class="font-monospace text-muted small me-1">@r.Number</span>
                                <a asp-page="/Requests/Request" asp-route-id="@r.Id" class="text-decoration-none">@r.Title</a>
                                @if (r.RequesterId != Model.MeId)
                                {
                                    <div class="small text-muted">Logged by @r.Requester.DisplayName</div>
                                }
                                <div class="small text-muted d-md-none">@r.Department.Name</div>
                            </td>
                            <td class="d-none d-md-table-cell">@r.Department.Name</td>
                            <td><span class="badge @Ui.RequestStatusBadge(r.Status)">@r.Status.Label()</span></td>
                            <td class="d-none d-sm-table-cell text-nowrap small" title="@Ui.When(r.CreatedAt)">@Ui.Ago(r.CreatedAt)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (Model.Mine.Count == Orbit.Pages.Requests.IndexModel.MyRequestsShown)
        {
            <div class="card-footer small text-muted">Showing @Orbit.Pages.Requests.IndexModel.MyRequestsShown: your open requests first, then the most recent.</div>
        }
    }
</div>

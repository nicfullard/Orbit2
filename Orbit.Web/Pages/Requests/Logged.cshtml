@page "{id:guid}"
@model Orbit.Pages.Requests.LoggedModel
@{
    var t = Model.Logged.Task;
    ViewData["Title"] = $"Request {t.Number} logged";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a asp-page="/Requests/Index">Requests</a></li>
        <li class="breadcrumb-item active" aria-current="page">@t.Number</li>
    </ol>
</nav>

<partial name="_Steps" model="4" />

<div class="card request-flow">
    <div class="card-body p-4 text-center">
        <div class="request-done-icon mb-3">@RequestIcons.Svg("check", 48)</div>
        <h1 class="h3 mb-2">Request <span class="font-monospace">@t.Number</span> logged</h1>
        <p class="mb-1 fw-semibold">@t.Title</p>
        <p class="text-muted mb-4">
            It is with <strong>@t.Department.Name</strong>, who will pick it up from their list of work.
            You can follow it under <em>Your requests</em> on the Requests page.
        </p>
        <div class="d-flex flex-wrap justify-content-center gap-2">
            @if (Model.Logged.CanOpen)
            {
                <a class="btn btn-outline-primary" asp-page="/Tasks/Details" asp-route-id="@t.Id">View the request</a>
            }
            <a class="btn btn-primary" asp-page="/Requests/Index">Log another request</a>
        </div>
    </div>
</div>

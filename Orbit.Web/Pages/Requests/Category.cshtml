@page "{id:guid}"
@model Orbit.Pages.Requests.CategoryModel
@{
    var c = Model.Category;
    ViewData["Title"] = c.Title;
    var colour = RequestIcons.ColourClass(c.Colour);
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a asp-page="/Requests/Index">Requests</a></li>
        <li class="breadcrumb-item active" aria-current="page">@c.Title</li>
    </ol>
</nav>

<div class="d-flex align-items-center gap-3 mb-3 @colour">
    <span class="request-icon request-icon-sm">@RequestIcons.Svg(c.Icon, 24)</span>
    <div>
        <h1 class="h3 mb-0">@c.Title</h1>
        <div class="text-muted">
            @if (!string.IsNullOrWhiteSpace(c.Description)) { @c.Description <text> · </text> }
            Handled by @c.Department.Name
        </div>
    </div>
</div>

<partial name="_Steps" model="1" />

<div class="row g-3 mb-3">
    @foreach (var f in c.Flows)
    {
        <div class="col-12 col-lg-6">
            <a class="request-option @colour" asp-page="/Requests/Start" asp-route-id="@f.Id">
                <span class="request-option-icon">@RequestIcons.Svg(c.Icon, 20)</span>
                <span>
                    <span class="request-option-title d-block">@f.Title</span>
                    @if (!string.IsNullOrWhiteSpace(f.Description)) { <span class="small text-muted d-block">@f.Description</span> }
                </span>
                <span class="request-go">@RequestIcons.Svg("arrow-right", 16)</span>
            </a>
        </div>
    }
</div>

<a asp-page="/Requests/Index" class="small">&larr; Back to all requests</a>

@page "{id:guid}"
@model Orbit.Pages.Requests.FormModel
@using Orbit.Pages.Requests
@{
    var s = Model.Step;
    var r = s.Request;
    ViewData["Title"] = s.FlowStep.Title;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a asp-page="/Requests/Index">Requests</a></li>
        <li class="breadcrumb-item"><a asp-page="/Requests/Request" asp-route-id="@r.Id">@r.Number</a></li>
        <li class="breadcrumb-item active" aria-current="page">@s.FlowStep.Title</li>
    </ol>
</nav>

<div class="mb-3">
    <h1 class="h3 mb-0">@s.FlowStep.Title</h1>
    <div class="text-muted">For request <strong>@r.Number</strong> @r.Title, logged by @r.Requester.DisplayName.</div>
</div>

@if (Model.GeneralError is not null)
{
    <div class="alert alert-danger request-flow" role="alert">@Model.GeneralError</div>
}
else if (Model.Errors.Count > 0)
{
    <div class="alert alert-danger request-flow" role="alert">
        @(Model.Errors.Count == 1 ? "One answer needs attention." : $"{Model.Errors.Count} answers need attention.") It's marked below.
    </div>
}

<form method="post" enctype="multipart/form-data" asp-route-id="@s.Id" class="request-flow js-request-flow">
    <div class="card">
        <div class="card-header bg-transparent js-wizard-only">
            <div class="d-flex justify-content-between gap-2 small text-muted mb-1">
                <span class="js-step-counter" aria-live="polite"></span>
            </div>
            <div class="progress" role="progressbar" aria-label="Progress through the form" aria-valuemin="0" aria-valuemax="100">
                <div class="progress-bar js-step-bar"></div>
            </div>
        </div>
        <div class="card-body p-3 p-md-4">
            <partial name="_FormFields" model="@(new RequestFormFieldsVm
            {
                Fields = s.FlowStep.Fields.ToList(),
                Answers = Model.Answers,
                Errors = Model.Errors,
                Labels = Model.Labels,
                AssetTypes = Model.AssetTypes,
                LookupUrl = Url.Page("/Requests/Lookup")!,
                Limits = Model.AttachmentLimits,
                FilesDropped = Model.FilesDropped
            })" />
            <section class="js-review-step js-wizard-only" aria-labelledby="review-heading" hidden>
                <h2 class="h5" id="review-heading" tabindex="-1">Check your answers</h2>
                <dl class="request-review js-review mb-0"></dl>
            </section>
        </div>
        <div class="card-footer bg-transparent d-flex flex-wrap gap-2">
            <button type="button" class="btn btn-outline-secondary js-back js-wizard-only">Back</button>
            <button type="button" class="btn btn-primary ms-auto js-next js-wizard-only">Next</button>
            <button type="submit" class="btn btn-success ms-auto js-submit" data-submitting="Saving...">Save answers</button>
        </div>
    </div>
</form>

@section Scripts {
    <script src="~/js/requests.js" asp-append-version="true"></script>
}

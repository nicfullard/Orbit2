@page
@model Orbit.Pages.Admin.Users.CreateModel
@{
    ViewData["Title"] = "Create user";
    var authItems = Ui.EnumItems<AuthSource>(Model.Form.AuthSource, null, a => a.Label());
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a asp-page="/Admin/Users/Index">Users</a></li>
        <li class="breadcrumb-item active" aria-current="page">Create</li>
    </ol>
</nav>
<h1 class="h3 mb-3">Create user</h1>

<div class="card" style="max-width:48rem">
    <div class="card-body">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label" for="Form_Email">Email (sign-in name)</label>
                    <input type="email" class="form-control" id="Form_Email" name="Form.Email" value="@Model.Form.Email" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="Form_DisplayName">Display name</label>
                    <input class="form-control" id="Form_DisplayName" name="Form.DisplayName" value="@Model.Form.DisplayName" maxlength="200" required />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="Form_RoleId">Role</label>
                    <select class="form-select js-role-select" id="Form_RoleId" name="Form.RoleId" data-department-target="#Form_DepartmentId" data-department-hint="#departmentHint">
                        @foreach (var r in Model.RoleItems)
                        {
                            <option value="@r.Id" data-requires-department="@(r.RequiresDepartment ? "true" : "false")" title="@r.Description" selected="@(r.Id == Model.Form.RoleId)">@r.Name</option>
                        }
                    </select>
                    <div class="form-text">What the user may do: <a asp-page="/Admin/Roles/Index">Admin &gt; Roles</a>.</div>
                </div>
                <div class="col-md-8">
                    <label class="form-label" for="Form_DepartmentId">Department</label>
                    <select class="form-select" id="Form_DepartmentId" name="Form.DepartmentId" asp-items="Model.DepartmentItems"></select>
                    <div class="form-text" id="departmentHint">Required for a role with permissions scoped to a department.</div>
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="Form_AuthSource">Sign-in method</label>
                    <select class="form-select js-auth-source" id="Form_AuthSource" name="Form.AuthSource" asp-items="authItems"></select>
                    <div class="form-text">
                        @if (Model.DirectoryEnabled)
                        {
                            <text>Directory users sign in with their company (Active Directory) password. The email above must match their directory account.</text>
                        }
                        else
                        {
                            <text>Directory sign-in isn't enabled yet. Set it up under <a asp-page="/Admin/Directory/Index">Admin &gt; Directory</a> to use it.</text>
                        }
                    </div>
                </div>
                <div class="col-md-6 js-local-password">
                    <label class="form-label" for="Form_Password">Temporary password</label>
                    <input type="text" class="form-control" id="Form_Password" name="Form.Password" value="@Model.Form.Password" required autocomplete="off" />
                    <div class="form-text">At least 8 characters with upper, lower case and a digit. The user changes it after signing in.</div>
                </div>
            </div>
            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Create user</button>
                <a class="btn btn-outline-secondary" asp-page="/Admin/Users/Index">Cancel</a>
            </div>
        </form>
    </div>
</div>

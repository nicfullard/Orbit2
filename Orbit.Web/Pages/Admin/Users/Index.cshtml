@page
@model Orbit.Pages.Admin.Users.IndexModel
@{
    ViewData["Title"] = "Users";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <div>
        <h1 class="h3 mb-0">Users</h1>
        <div class="text-muted small">Self-registration is disabled; accounts are created here.</div>
    </div>
    <a class="btn btn-primary btn-sm" asp-page="/Admin/Users/Create">Create user</a>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light"><tr><th>Name</th><th>Email</th><th>Role</th><th>Department</th><th>Status</th><th>Created</th><th></th></tr></thead>
                <tbody>
                    @foreach (var u in Model.Users)
                    {
                        <tr class="@(u.IsActive ? "" : "text-muted")">
                            <td class="fw-semibold">@u.DisplayName</td>
                            <td>@u.Email @if (u.AuthSource == AuthSource.Ldap) { <span class="badge text-bg-info" title="Signs in with the company directory">LDAP</span> }</td>
                            <td><span class="badge @Ui.RoleBadge(u.Role)">@u.Role.Name</span></td>
                            <td>@(u.DepartmentName ?? "-")</td>
                            <td>@if (u.IsActive) { <span class="badge text-bg-success">Active</span> } else { <span class="badge text-bg-secondary">Deactivated</span> }
                                @if (u.IsLockedOut) { <span class="badge text-bg-warning" title="Too many wrong passwords. Unlock from the user's page.">Locked out</span> }</td>
                            <td>@Ui.Day(DateOnly.FromDateTime(u.CreatedAt))</td>
                            <td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-page="/Admin/Users/Edit" asp-route-id="@u.Id">Manage</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

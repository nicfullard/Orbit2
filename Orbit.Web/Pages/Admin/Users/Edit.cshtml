@page "{id:guid}"
@model Orbit.Pages.Admin.Users.EditModel
@{
    var u = Model.Account;
    ViewData["Title"] = u.DisplayName;
    var authItems = Ui.EnumItems<AuthSource>(Model.Form.AuthSource, null, a => a.Label());
    var isSelf = Model.Actor.UserId == u.Id;
    var isDirectoryUser = u.AuthSource == AuthSource.Ldap;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a asp-page="/Admin/Users/Index">Users</a></li>
        <li class="breadcrumb-item active" aria-current="page">@u.DisplayName</li>
    </ol>
</nav>

<div class="d-flex flex-wrap justify-content-between align-items-start mb-3 gap-2">
    <div>
        <h1 class="h3 mb-1">@u.DisplayName</h1>
        <div class="text-muted">@u.Email · <span class="badge @Ui.RoleBadge(u.Role)">@u.Role.Name</span>
            @if (u.IsActive) { <span class="badge text-bg-success">Active</span> } else { <span class="badge text-bg-secondary">Deactivated</span> }
            @if (isDirectoryUser) { <span class="badge text-bg-info">LDAP</span> }
            @if (u.IsLockedOut) { <span class="badge text-bg-warning">Locked out until @Ui.When(u.LockoutEnd!.Value.UtcDateTime)</span> }
        </div>
    </div>
    <div class="d-flex gap-2">
        @if (u.IsLockedOut)
        {
            <form method="post" asp-page-handler="Unlock" asp-route-id="@u.Id">
                <button class="btn btn-outline-warning btn-sm" type="submit" title="Too many wrong passwords locked this account. Unlocking lets them try again now.">Unlock</button>
            </form>
        }
        @if (u.IsActive && !isSelf)
        {
            <form method="post" asp-page-handler="Deactivate" asp-route-id="@u.Id" data-confirm="Deactivate this user? They will be signed out and unable to sign in. Their tasks, comments and history are kept.">
                <button class="btn btn-outline-danger btn-sm" type="submit">Deactivate</button>
            </form>
        }
        else if (!u.IsActive)
        {
            <form method="post" asp-page-handler="Reactivate" asp-route-id="@u.Id">
                <button class="btn btn-outline-success btn-sm" type="submit">Reactivate</button>
            </form>
        }
    </div>
</div>

@if (Model.ResetLink is not null)
{
    <div class="alert alert-info">
        <div class="fw-semibold mb-1">One-time password reset link</div>
        <div class="d-flex gap-2 align-items-start">
            <textarea class="form-control key-box" id="resetLink" rows="2" readonly>@Model.ResetLink</textarea>
            <button class="btn btn-outline-secondary btn-sm" type="button" data-copy-target="#resetLink">Copy</button>
        </div>
        <div class="small mt-1">Give this to the user. It is not shown again.</div>
    </div>
}

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card mb-3">
            <div class="card-header fw-semibold">Profile, role and department</div>
            <div class="card-body">
                <form method="post" asp-route-id="@u.Id">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
                    <input type="hidden" name="Form.Email" value="@u.Email" />
                    <div class="row g-3">
                        <div class="col-md-12">
                            <label class="form-label" for="Form_DisplayName">Display name</label>
                            <input class="form-control" id="Form_DisplayName" name="Form.DisplayName" value="@Model.Form.DisplayName" maxlength="200" required />
                        </div>
                        <div class="col-md-5">
                            <label class="form-label" for="Form_RoleId">Role</label>
                            <select class="form-select js-role-select" id="Form_RoleId" name="Form.RoleId" data-department-target="#Form_DepartmentId" data-department-hint="#departmentHint">
                                @foreach (var r in Model.RoleItems)
                                {
                                    <option value="@r.Id" data-requires-department="@(r.RequiresDepartment ? "true" : "false")" title="@r.Description" selected="@(r.Id == Model.Form.RoleId)">@r.Name</option>
                                }
                            </select>
                            <div class="form-text">What the user may do: <a asp-page="/Admin/Roles/Index">Admin &gt; Roles</a>.</div>
                        </div>
                        <div class="col-md-7">
                            <label class="form-label" for="Form_DepartmentId">Department</label>
                            <select class="form-select" id="Form_DepartmentId" name="Form.DepartmentId" asp-items="Model.DepartmentItems"></select>
                            <div class="form-text" id="departmentHint">Required for a role with permissions scoped to a department.</div>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label" for="Form_AuthSource">Sign-in method</label>
                            <select class="form-select" id="Form_AuthSource" name="Form.AuthSource" asp-items="authItems"></select>
                            <div class="form-text">
                                Directory users sign in with their company (Active Directory) password; the email above must match their directory account.
                                Switching method removes any password Orbit holds for the user and signs them out.
                                @if (!Model.DirectoryEnabled)
                                {
                                    <text>Directory sign-in isn't enabled yet - set it up under <a asp-page="/Admin/Directory/Index">Admin &gt; Directory</a>.</text>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="mt-3 d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Save</button>
                        <a class="btn btn-outline-secondary" asp-page="/Admin/Users/Index">Back</a>
                    </div>
                    @if (isSelf)
                    {
                        <div class="form-text mt-2">This is your own account. At least one active System Administrator with a local password must always remain.</div>
                    }
                </form>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card mb-3">
            <div class="card-header fw-semibold">Password</div>
            @if (isDirectoryUser)
            {
                <div class="card-body">
                    <p class="small text-muted mb-0">This user signs in with the company directory. Orbit holds no password for them: it is changed and reset in the directory, and disabling the directory account stops new sign-ins. Deactivate the user here as well to end a session that is already open.</p>
                </div>
            }
            else
            {
            <div class="card-body">
                <p class="small text-muted">Either generate a one-time reset link (Identity's standard reset flow) or set a temporary password to hand over directly.</p>
                <form method="post" asp-page-handler="ResetLink" asp-route-id="@u.Id" class="mb-3">
                    <button class="btn btn-outline-primary btn-sm" type="submit" @(u.IsActive ? "" : "disabled")>Generate reset link</button>
                </form>
                <form method="post" asp-page-handler="SetPassword" asp-route-id="@u.Id" class="d-flex gap-2 align-items-end">
                    <div class="flex-grow-1">
                        <label class="form-label small mb-0" for="TemporaryPassword">Temporary password</label>
                        <input type="text" class="form-control form-control-sm" id="TemporaryPassword" name="TemporaryPassword" autocomplete="off" required />
                    </div>
                    <button class="btn btn-outline-secondary btn-sm" type="submit" @(u.IsActive ? "" : "disabled")>Set</button>
                </form>
            </div>
            }
        </div>
    </div>
</div>

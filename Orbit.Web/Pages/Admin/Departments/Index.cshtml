@page
@model Orbit.Pages.Admin.Departments.IndexModel
@{
    ViewData["Title"] = "Departments";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <div>
        <h1 class="h3 mb-0">Departments</h1>
        <div class="text-muted small">Every department with its headline counts.</div>
    </div>
    <a class="btn btn-primary btn-sm" asp-page="/Admin/Departments/Create">New department</a>
</div>

<div class="card">
    <div class="card-body p-0">
        @if (Model.Departments.Count == 0)
        {
            <p class="text-muted fst-italic p-3 mb-0">No departments yet. Create one, then add users to it.</p>
        }
        else
        {
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light"><tr><th>Department</th><th class="text-end">Users</th><th class="text-end">Active projects</th><th class="text-end">Open tasks</th><th>Status</th><th></th></tr></thead>
                <tbody>
                    @foreach (var d in Model.Departments)
                    {
                        <tr class="@(d.Department.IsArchived ? "text-muted" : "")">
                            <td>
                                <a asp-page="/Admin/Departments/Details" asp-route-id="@d.Department.Id" class="fw-semibold text-decoration-none">@d.Department.Name</a>
                                @if (!string.IsNullOrWhiteSpace(d.Department.Description))
                                {
                                    <div class="small text-muted">@Ui.Truncate(d.Department.Description, 120)</div>
                                }
                            </td>
                            <td class="text-end">@d.UserCount</td>
                            <td class="text-end">@d.ActiveProjectCount</td>
                            <td class="text-end">@d.OpenTaskCount</td>
                            <td>@if (d.Department.IsArchived) { <span class="badge text-bg-secondary">Archived</span> } else { <span class="badge text-bg-success">Active</span> }</td>
                            <td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-page="/Admin/Departments/Edit" asp-route-id="@d.Department.Id">Edit</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

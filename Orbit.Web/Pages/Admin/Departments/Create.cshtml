@page
@model Orbit.Pages.Admin.Departments.CreateModel
@{
    ViewData["Title"] = "New department";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a asp-page="/Admin/Departments/Index">Departments</a></li>
        <li class="breadcrumb-item active" aria-current="page">New</li>
    </ol>
</nav>
<h1 class="h3 mb-3">New department</h1>
<div class="card" style="max-width:40rem">
    <div class="card-body">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
            <div class="mb-3">
                <label class="form-label" for="Name">Name</label>
                <input class="form-control" id="Name" name="Name" value="@Model.Name" maxlength="200" required placeholder="e.g. IT, Warehouse Ops" />
            </div>
            <div class="mb-3">
                <label class="form-label" for="Description">Description <span class="text-muted">(optional)</span></label>
                <textarea class="form-control" id="Description" name="Description" rows="3" maxlength="2000">@Model.Description</textarea>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Create</button>
                <a class="btn btn-outline-secondary" asp-page="/Admin/Departments/Index">Cancel</a>
            </div>
        </form>
    </div>
</div>

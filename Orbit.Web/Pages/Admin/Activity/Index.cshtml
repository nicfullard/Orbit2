@page
@model Orbit.Pages.Admin.Activity.IndexModel
@{
    ViewData["Title"] = "Activity log";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <div>
        <h1 class="h3 mb-0">Activity log</h1>
        <div class="text-muted small">Every audited write: who or what made it, and when. API writes are tagged Claude.</div>
    </div>
</div>

<form method="get" class="card mb-3">
    <div class="card-body py-2">
        <div class="row g-2 align-items-end">
            <div class="col-sm-6 col-lg-2">
                <label class="form-label small mb-0">From</label>
                <input type="datetime-local" class="form-control form-control-sm" name="From" value="@Model.From?.ToLocalTime().ToString("yyyy-MM-ddTHH:mm")" />
            </div>
            <div class="col-sm-6 col-lg-2">
                <label class="form-label small mb-0">To</label>
                <input type="datetime-local" class="form-control form-control-sm" name="To" value="@Model.To?.ToLocalTime().ToString("yyyy-MM-ddTHH:mm")" />
            </div>
            <div class="col-sm-6 col-lg-2">
                <label class="form-label small mb-0">Entity</label>
                <select class="form-select form-select-sm" name="EntityType">
                    <option value="">All</option>
                    @foreach (var t in Orbit.Pages.Admin.Activity.IndexModel.EntityTypes)
                    {
                        <option value="@t" selected="@(t == Model.EntityType)">@t</option>
                    }
                </select>
            </div>
            @if (Model.CanFilterDepartments)
            {
                <div class="col-sm-6 col-lg-2">
                    <label class="form-label small mb-0">Department</label>
                    <select class="form-select form-select-sm" name="DepartmentId">
                        <option value="">All</option>
                        @foreach (var i in Model.DepartmentItems) { <option value="@i.Value" selected="@i.Selected">@i.Text</option> }
                    </select>
                </div>
            }
            <div class="col-auto">
                <button class="btn btn-sm btn-outline-primary" type="submit">Filter</button>
                <a class="btn btn-sm btn-link" asp-page="/Admin/Activity/Index">Reset</a>
            </div>
        </div>
    </div>
</form>

<div class="card">
    <div class="card-body p-0">
        @if (Model.Result.Items.Count == 0)
        {
            <p class="text-muted fst-italic p-3 mb-0">No activity in this window.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle mb-0">
                    <thead class="table-light"><tr><th>When</th><th>Actor</th><th>Action</th><th>Entity</th><th>Details</th></tr></thead>
                    <tbody>
                        @foreach (var a in Model.Result.Items)
                        {
                            <tr>
                                <td class="text-nowrap">@Ui.When(a.Timestamp)</td>
                                <td>
                                    @a.ActorName
                                    @if (a.ActorType == ActorType.Api) { <span class="badge badge-claude">Claude</span> }
                                    else if (a.ActorType == ActorType.System) { <span class="badge text-bg-secondary">System</span> }
                                </td>
                                <td>@a.Action</td>
                                <td>
                                    <span class="badge text-bg-light border">@a.EntityType</span>
                                    @if (a.EntityType == AuditEntity.Task)
                                    {
                                        <a asp-page="/Tasks/Details" asp-route-id="@a.EntityId" class="text-decoration-none">@Ui.Truncate(a.Summary, 60)</a>
                                    }
                                    else if (a.EntityType == AuditEntity.Project)
                                    {
                                        <a asp-page="/Projects/Details" asp-route-id="@a.EntityId" class="text-decoration-none">@Ui.Truncate(a.Summary, 60)</a>
                                    }
                                    else
                                    {
                                        @Ui.Truncate(a.Summary, 60)
                                    }
                                </td>
                                <td class="key-box small text-muted" style="max-width:28rem">@Ui.Truncate(a.Details, 200)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
    @if (Model.Result.TotalPages > 1)
    {
        <div class="card-footer d-flex justify-content-between align-items-center small">
            <span>Page @Model.Result.Page of @Model.Result.TotalPages (@Model.Result.TotalCount entries)</span>
            <div>
                @if (Model.Result.HasPrevious) { <a class="btn btn-sm btn-outline-secondary" asp-page="/Admin/Activity/Index" asp-route-From="@Model.From" asp-route-To="@Model.To" asp-route-EntityType="@Model.EntityType" asp-route-DepartmentId="@Model.DepartmentId" asp-route-PageNumber="@(Model.Result.Page - 1)">Previous</a> }
                @if (Model.Result.HasNext) { <a class="btn btn-sm btn-outline-secondary" asp-page="/Admin/Activity/Index" asp-route-From="@Model.From" asp-route-To="@Model.To" asp-route-EntityType="@Model.EntityType" asp-route-DepartmentId="@Model.DepartmentId" asp-route-PageNumber="@(Model.Result.Page + 1)">Next</a> }
            </div>
        </div>
    }
</div>

@page
@using Orbit.Application.Assets
@model Orbit.Pages.Assets.CreateModel
@{
    ViewData["Title"] = "Register asset";
    ViewData["Form"] = Model.Form;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a asp-page="/Assets/Index">Assets</a></li>
        <li class="breadcrumb-item active" aria-current="page">Register</li>
    </ol>
</nav>
<h1 class="h3 mb-3">Register asset</h1>
@if (Model.CopiedFrom is { } source)
{
    <div class="alert alert-info small py-2">
        Copied from <a asp-page="/Assets/Details" asp-route-id="@source.Id">@AssetRules.Label(source.AssetNumber, source.Name)</a>.
        Enter this item's own ERP asset number and serial number. Holders, checks, comments and files aren't copied.
    </div>
}
<div class="card">
    <div class="card-body">
        <form method="post" class="js-asset-form"
              data-properties-url="@Url.Page("/Assets/Create", "Properties")"
              data-choices-url="@Url.Page("/Assets/Create", "Choices")">
            <partial name="_AssetFormFields" model="Model.Lookups" view-data="ViewData" />
            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Register asset</button>
                <a class="btn btn-outline-secondary" asp-page="/Assets/Index">Cancel</a>
            </div>
        </form>
    </div>
</div>

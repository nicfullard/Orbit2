@model EstimateAccuracyReport
@using Orbit.Pages.Reports
@{
    string VarianceClass(int v) => v > 0 ? "text-warning-emphasis" : v < 0 ? "text-success-emphasis" : "";
}

@if (Model.Rows.Count == 0)
{
    <p class="text-muted fst-italic p-3 mb-0">No data for the selected filters.</p>
}
else
{
    <table class="table table-sm align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th style="width:24%">Assignee</th>
                <th class="text-end">Done</th>
                <th class="text-end" title="Completed tasks that have an estimate">With estimate</th>
                <th class="text-end">Estimated</th>
                <th class="text-end" title="All time logged on the estimated tasks, by anyone">Actual</th>
                <th class="text-end">Variance</th>
                <th class="text-end" title="Tasks whose logged time passed their estimate">Over estimate</th>
            </tr>
        </thead>
        <tbody>
            @for (var i = 0; i < Model.Rows.Count; i++)
            {
                var r = Model.Rows[i];
                var id = $"estimate-assignee-{i}";
                <tr>
                    <td>@r.Name</td>
                    <td class="text-end">
                        <a href="#@id" data-bs-toggle="collapse" role="button" aria-expanded="false" aria-controls="@id" title="Show the tasks">@r.DoneCount</a>
                    </td>
                    <td class="text-end">@r.Estimate.EstimatedTasks</td>
                    <td class="text-end">@ViewModel.Estimated(r.Estimate)</td>
                    <td class="text-end fw-semibold">@ViewModel.Actual(r.Estimate)</td>
                    <td class="text-end @VarianceClass(r.Estimate.VarianceMinutes)">@ViewModel.Variance(r.Estimate)</td>
                    <td class="text-end">@r.Estimate.OverTasks</td>
                </tr>
                <tr class="collapse" id="@id">
                    <td colspan="7" class="p-0">
                        <table class="table table-sm small mb-0">
                            <thead>
                                <tr class="text-muted">
                                    <th class="ps-4">Task</th>
                                    <th class="text-end">Estimate</th>
                                    <th class="text-end">Actual</th>
                                    <th class="text-end">Variance</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var t in r.Tasks)
                                {
                                    <tr>
                                        <td class="ps-4"><a asp-page="/Tasks/Details" asp-route-id="@t.TaskId" class="text-decoration-none">@t.Number</a> @t.Title</td>
                                        <td class="text-end">@ViewModel.Estimate(t.EstimateMinutes)</td>
                                        <td class="text-end">@TimeFormat.Minutes(t.ActualMinutes)</td>
                                        @if (t.VarianceMinutes is int v)
                                        {
                                            <td class="text-end @VarianceClass(v)">@TimeFormat.Signed(v)</td>
                                        }
                                        else
                                        {
                                            <td class="text-end">-</td>
                                        }
                                        <td>
                                            @if (t.IsOver)
                                            {
                                                <span class="badge text-bg-warning" title="More time has been logged than was estimated">Over estimate</span>
                                            }
                                            else if (t.EstimateMinutes is null)
                                            {
                                                <span class="text-muted">No estimate</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr class="table-light">
                <th>Overall</th>
                <th class="text-end">@Model.DoneCount</th>
                <th class="text-end">@Model.Overall.EstimatedTasks</th>
                <th class="text-end">@ViewModel.Estimated(Model.Overall)</th>
                <th class="text-end">@ViewModel.Actual(Model.Overall)</th>
                <th class="text-end @VarianceClass(Model.Overall.VarianceMinutes)">@ViewModel.Variance(Model.Overall)</th>
                <th class="text-end">@Model.Overall.OverTasks</th>
            </tr>
        </tfoot>
    </table>
    <div class="small text-muted px-3 py-2 border-top">
        Tasks set to Done in the period, under whoever they are assigned to. Estimated, actual and variance cover the tasks
        with an estimate; actual is all time logged on them, by anyone. Click a Done count to see the tasks, largest overrun first.
    </div>
}

@page
@model Orbit.Pages.AssetTypes.IndexModel
@{
    ViewData["Title"] = "Asset types";
    var everywhere = Model.Actor.CanAnywhere(Permission.AssetsConfigure);
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a asp-page="/Assets/Index">Assets</a></li>
        <li class="breadcrumb-item active" aria-current="page">Asset types</li>
    </ol>
</nav>
<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <div>
        <h1 class="h3 mb-0">Asset types</h1>
        <div class="text-muted small">
            Each department defines the kinds of asset it manages, with their own properties and how often they should be checked.
        </div>
    </div>
    <a class="btn btn-primary btn-sm" asp-page="/AssetTypes/Create">New asset type</a>
</div>

<form method="get" class="card mb-3">
    <div class="card-body py-2">
        <div class="row g-2 align-items-end">
            @if (everywhere)
            {
                <div class="col-sm-4 col-lg-3">
                    <label class="form-label small mb-0">Department</label>
                    <select class="form-select form-select-sm" name="DepartmentId">
                        <option value="">All</option>
                        @foreach (var i in Model.DepartmentItems) { <option value="@i.Value" selected="@i.Selected">@i.Text</option> }
                    </select>
                </div>
            }
            <div class="col-auto form-check ms-2 mb-1">
                <input class="form-check-input" type="checkbox" id="ShowArchived" name="ShowArchived" value="true" checked="@Model.ShowArchived" />
                <label class="form-check-label small" for="ShowArchived">Show archived</label>
            </div>
            <div class="col-auto">
                <button class="btn btn-sm btn-outline-primary" type="submit">Filter</button>
            </div>
        </div>
    </div>
</form>

<div class="card">
    <div class="card-body p-0">
        @if (Model.Types.Count == 0)
        {
            <p class="text-muted fst-italic p-3 mb-0">No asset types yet. Create one - Laptop, Vehicle, Fire extinguisher - before registering assets.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Type</th>
                            @if (everywhere) { <th>Department</th> }
                            <th>Category</th>
                            <th>Check every</th>
                            <th class="text-end">Properties</th>
                            <th class="text-end">Assets</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Types)
                        {
                            var t = row.Type;
                            <tr class="@(t.IsArchived ? "text-muted" : "")">
                                <td>
                                    <a asp-page="/AssetTypes/Edit" asp-route-id="@t.Id" class="fw-semibold text-decoration-none">@t.Name</a>
                                    @if (t.IsArchived) { <span class="badge text-bg-secondary">Archived</span> }
                                    @if (!string.IsNullOrWhiteSpace(t.Description)) { <div class="small text-muted">@Ui.Truncate(t.Description, 120)</div> }
                                </td>
                                @if (everywhere) { <td><span class="badge text-bg-light border">@t.Department.Name</span></td> }
                                <td>@(t.Category ?? "-")</td>
                                <td>@(t.CheckIntervalDays is int d ? $"{d} days" : "-")</td>
                                <td class="text-end">@row.PropertyCount</td>
                                <td class="text-end">
                                    <a class="text-decoration-none" asp-page="/Assets/Index" asp-route-AssetTypeId="@t.Id">@row.AssetCount</a>
                                </td>
                                <td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-page="/AssetTypes/Edit" asp-route-id="@t.Id">Edit</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

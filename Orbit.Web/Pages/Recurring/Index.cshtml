@page
@model Orbit.Pages.Recurring.IndexModel
@{
    ViewData["Title"] = "Recurring tasks";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <div>
        <h1 class="h3 mb-0">Recurring tasks</h1>
        <div class="text-muted small">Definitions that generate task instances on a schedule. Generated tasks land in the backlog.</div>
    </div>
    <a class="btn btn-primary btn-sm" asp-page="/Recurring/Create">New recurring task</a>
</div>

<div class="card">
    <div class="card-body p-0">
        @if (Model.Definitions.Count == 0)
        {
            <p class="text-muted fst-italic p-3 mb-0">No recurring task definitions.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Title</th>
                            <th>Project</th>
                            @if (Model.Actor.IsSystemAdmin) { <th>Department</th> }
                            <th>Rule</th>
                            <th>Next due</th>
                            <th>Lead</th>
                            <th>Assignee</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in Model.Definitions)
                        {
                            var canEdit = AccessPolicy.CanEditRecurring(Model.Actor, d);
                            <tr>
                                <td><a asp-page="/Recurring/Details" asp-route-id="@d.Id" class="fw-semibold text-decoration-none">@d.Title</a></td>
                                <td>@if (d.Project is not null) { <a asp-page="/Projects/Details" asp-route-id="@d.ProjectId" class="text-decoration-none">@d.Project.Name</a> } else { <span class="text-muted">-</span> }</td>
                                @if (Model.Actor.IsSystemAdmin) { <td><span class="badge text-bg-light border">@d.Department.Name</span></td> }
                                <td><code>@d.RecurrenceRule</code></td>
                                <td>@Ui.Day(d.NextRunDate)</td>
                                <td>@d.LeadTimeDays d</td>
                                <td>@(d.Assignee?.DisplayName ?? "-")</td>
                                <td>@if (d.Active) { <span class="badge text-bg-success">Active</span> } else { <span class="badge text-bg-secondary">Paused</span> }</td>
                                <td class="text-end text-nowrap">
                                    @if (canEdit)
                                    {
                                        <form method="post" asp-page-handler="Toggle" asp-route-id="@d.Id" asp-route-active="@(!d.Active)" class="d-inline">
                                            <button class="btn btn-sm btn-outline-secondary" type="submit">@(d.Active ? "Pause" : "Resume")</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

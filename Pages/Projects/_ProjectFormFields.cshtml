@using Orbit.Pages.Projects
@model ProjectFormLookups
@{
    var form = ViewData["Form"] as ProjectForm ?? new ProjectForm();
    var statusItems = Ui.EnumItems<ProjectStatus>(form.Status, null, s => s.Label());
}

<div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

<div class="mb-3">
    <label class="form-label" for="Form_Name">Name</label>
    <input class="form-control" id="Form_Name" name="Form.Name" value="@form.Name" maxlength="200" required />
</div>
<div class="mb-3">
    <label class="form-label" for="Form_Description">Description</label>
    <textarea class="form-control" id="Form_Description" name="Form.Description" rows="4">@form.Description</textarea>
</div>
<div class="row g-3">
    @if (Model.Actor.IsSystemAdmin)
    {
        <div class="col-md-4">
            <label class="form-label" for="Form_DepartmentId">Department</label>
            <select class="form-select" id="Form_DepartmentId" name="Form.DepartmentId" asp-items="Model.Departments" required></select>
        </div>
    }
    else
    {
        <input type="hidden" name="Form.DepartmentId" value="@form.DepartmentId" />
    }
    <div class="col-md-4">
        <label class="form-label" for="Form_OwnerId">Owner</label>
        <select class="form-select" id="Form_OwnerId" name="Form.OwnerId" asp-items="Model.Owners"></select>
    </div>
    <div class="col-md-2">
        <label class="form-label" for="Form_Status">Status</label>
        <select class="form-select" id="Form_Status" name="Form.Status" asp-items="statusItems"></select>
    </div>
    <div class="col-md-2">
        <label class="form-label" for="Form_TargetDate">Target date</label>
        <input type="date" class="form-control" id="Form_TargetDate" name="Form.TargetDate" value="@(form.TargetDate?.ToString("yyyy-MM-dd"))" />
    </div>
</div>

@page
@model Orbit.Pages.Tasks.CreateModel
@{
    ViewData["Title"] = "New task";
    ViewData["IsEdit"] = false;
    ViewData["Form"] = Model.Form;
}

<h1 class="h3 mb-3">New task</h1>

<div class="card">
    <div class="card-body">
        <form method="post">
            <partial name="_TaskFormFields" model="Model.Lookups" view-data="ViewData" />
            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Create task</button>
                <a class="btn btn-outline-secondary" asp-page="/Tasks/Index">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

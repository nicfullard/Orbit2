@page "{id:guid}"
@model Orbit.Pages.Time.EditModel
@{
    ViewData["Title"] = "Edit time entry";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a asp-page="/Tasks/Details" asp-route-id="@Model.Entry.TaskId">@Ui.Truncate(Model.Entry.Task.Title, 60)</a></li>
        <li class="breadcrumb-item active" aria-current="page">Time entry</li>
    </ol>
</nav>
<h1 class="h3 mb-3">Edit time entry <span class="text-muted fs-6">by @Model.Entry.User.DisplayName</span></h1>

<div class="card" style="max-width:40rem">
    <div class="card-body">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
            <div class="row g-3">
                <div class="col-sm-5">
                    <label class="form-label" for="Form_Date">Date</label>
                    <input type="date" class="form-control" id="Form_Date" name="Form.Date" value="@Model.Form.Date.ToString("yyyy-MM-dd")" required />
                </div>
                <div class="col-sm-4">
                    <label class="form-label" for="Form_DurationMinutes">Minutes</label>
                    <input type="number" class="form-control" id="Form_DurationMinutes" name="Form.DurationMinutes" value="@Model.Form.DurationMinutes" min="1" max="1440" required />
                </div>
            </div>
            <div class="mt-3">
                <label class="form-label" for="Form_Note">Note</label>
                <input class="form-control" id="Form_Note" name="Form.Note" value="@Model.Form.Note" maxlength="1000" />
            </div>
            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Save</button>
                <a class="btn btn-outline-secondary" asp-page="/Tasks/Details" asp-route-id="@Model.Entry.TaskId">Cancel</a>
            </div>
        </form>
        <form method="post" asp-page-handler="Delete" asp-route-id="@Model.Entry.Id" class="mt-3" data-confirm="Delete this time entry?">
            <button type="submit" class="btn btn-link text-danger p-0">Delete entry</button>
        </form>
    </div>
</div>

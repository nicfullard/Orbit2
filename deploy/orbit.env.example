# /etc/orbit/orbit.env  (owner root:root, chmod 600)
# ASP.NET Core reads nested keys with a double underscore: ConnectionStrings:DefaultConnection -> ConnectionStrings__DefaultConnection

# Listen address (put nginx/Caddy in front for TLS)
ASPNETCORE_URLS=http://127.0.0.1:5000

# Database - a dedicated least-privilege role (see create-db-role.sql)
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=orbit;Username=orbit;Password=CHANGE_ME

# Public URL used in notification emails - and in the 'configure' command Orbit gives a new Orbit Agent, so it must be
# the https address the agent can reach from inside your network.
App__BaseUrl=https://orbit.example.com

# Persisted Data Protection key ring (chmod 700, owned by the orbit user, included in backups).
# Without this every restart regenerates the keys and signs everyone out.
DataProtection__KeyRingPath=/var/lib/orbit/keys

# Apply EF migrations at startup (set false if you apply them separately during deploys)
Database__ApplyMigrations=true

# Background jobs (Quartz.NET cron, seconds first: sec min hour day month weekday)
Jobs__RecurringTasks__Enabled=true
Jobs__RecurringTasks__Cron=0 0 2 * * ?
Jobs__RecurringTasks__RunOnStartup=true
Jobs__DueDateNotifications__Enabled=true
Jobs__DueDateNotifications__Cron=0 0 7 * * ?
Jobs__DueDateNotifications__LeadDays=1
Jobs__DueDateNotifications__RunOnStartup=true

# Sign-in hardening. For directory (LDAP) users every wrong password typed into Orbit is a real failed bind in Active
# Directory and counts towards AD's OWN lockout. Orbit must therefore lock first, or anyone who knows a colleague's email
# could lock their Windows account from the internet. A locked Orbit account is refused without AD being contacted, so
# AD sees at most MaxFailedAttempts bad binds per LockoutMinutes. Set:
#   MaxFailedAttempts  BELOW  AD's "Account lockout threshold" (leave room for the person's own typos elsewhere)
#   LockoutMinutes     AT LEAST  AD's "Reset account lockout counter after"
# The defaults suit the common AD policies (5 attempts / 30 min, or 10 / 15 min). Applies to local users too.
Security__Lockout__MaxFailedAttempts=3
Security__Lockout__LockoutMinutes=30
# Failed sign-ins allowed per client address per window, across ALL accounts (slows password spraying). Successful
# sign-ins cost nothing. Needs the reverse proxy to send X-Forwarded-For - see deploy/README.md - otherwise every user
# appears to be 127.0.0.1 and Orbit switches the throttle off (and says so in the log) rather than lock everyone out.
Security__LoginThrottle__Enabled=true
Security__LoginThrottle__MaxFailures=20
Security__LoginThrottle__WindowMinutes=15

# Orbit Agents (directory / LDAP sign-in). Directory servers etc. are set in the UI under Admin > Directory, not here.
# How long Orbit waits for an agent to answer a sign-in before trying the next agent / reporting "unavailable":
Agents__CommandTimeoutSeconds=15
# How long the one-time token shown under Admin > Agents > New agent stays valid:
Agents__RegistrationTokenLifetimeMinutes=60

# First-run System Admin bootstrap. Only consumed if no System Admin exists yet.
# Sign in, change the password, then DELETE these three lines and restart the service.
Seed__Admin__Email=admin@example.com
Seed__Admin__DisplayName=System Admin
Seed__Admin__Password=CHANGE_ME_TEMPORARY
